WorldInfo {
  info [
    "Simulation of the ROBOLAB P3Bot robot."
  ]
  title "ROBOLAB P3Bot"
  basicTimeStep 8
  contactProperties [
    ContactProperties {
      material1 "InteriorWheelMat"
      # Contact stiffness, NOT suspension. A rigid 4-wheel base should barely pitch under
      # acceleration: the traction force acts at ground level and inertia at the CoM, and that
      # moment is meant to be taken by the wheel NORMAL loads redistributing, not by the body
      # rotating. Webots' default softCFM (1e-3) lets each contact sink instead, so the chassis
      # rocks. Measured over an accelerate/brake cycle: 0.585 deg peak-to-peak before, 0.012 deg
      # after -- a 49x drop. coulombFriction/forceDependentSlip are untouched, so the mecanum
      # roller model and the wheel odometry FullPose depends on are unchanged.
      softCFM 1e-05
      softERP 0.9
      coulombFriction [
        0, 2, 0
      ]
      frictionRotation -0.785398 0
      bounce 0
      forceDependentSlip [
        10, 0
      ]
    }
    ContactProperties {
      material1 "ExteriorWheelMat"
      # Contact stiffness, NOT suspension. A rigid 4-wheel base should barely pitch under
      # acceleration: the traction force acts at ground level and inertia at the CoM, and that
      # moment is meant to be taken by the wheel NORMAL loads redistributing, not by the body
      # rotating. Webots' default softCFM (1e-3) lets each contact sink instead, so the chassis
      # rocks. Measured over an accelerate/brake cycle: 0.585 deg peak-to-peak before, 0.012 deg
      # after -- a 49x drop. coulombFriction/forceDependentSlip are untouched, so the mecanum
      # roller model and the wheel odometry FullPose depends on are unchanged.
      softCFM 1e-05
      softERP 0.9
      coulombFriction [
        0, 2, 0
      ]
      frictionRotation 0.785398 0
      bounce 0
      forceDependentSlip [
        10, 0
      ]
    }
    ContactProperties {
      material1 "finger_material"
      coulombFriction [
        1.5
      ]
      bounce 0
    }
  ]
}
