P3Bot {
  translation 0 0 0.63458
  rotation 0.001976227010431609 -0.0017332735998208913 -0.9999965451387477 1.5743783241502933
  arms [
    DEF KINOVA_ARM_R KinovaGen3 {
      translation 0 -0.0517612 1.04883
      rotation 1 0 0 2.01001
      name "kinova_arm_r"
      joint1Position 0
      joint2Position 0
      joint3Position 0
      joint4Position 0
      joint5Position 0
      joint6Position 0
      joint7Position 0
    }
    DEF KINOVA_ARM_L KinovaGen3 {
      translation 0.002 0.055 1.052
      rotation 1 0 0 -2.0100053071795863
      name "kinova_arm_l"
      prefix "Left_"
      joint1Position 0
      joint2Position 0
      joint3Position 0
      joint4Position 0
      joint5Position 0
      joint6Position 0
      joint7Position 0
    }
  ]
  wheels [
    DEF WHEEL1 HingeJoint {
      jointParameters HingeJointParameters {
        position -2.1896752360602516
        axis 0 1 0
        anchor 0.125 -0.24 0.08
      }
      device [
        # -- WHEEL DYNAMICS ARE LIMITED IN THE BRIDGE, NOT HERE -------------------------------------
        # !! DO NOT add an `acceleration` field to these wheel motors. Webots' RotationalMotor carries
        #   ONE SYMMETRIC number, but the real base accelerates at 0.35-0.50 m/s^2 and brakes at 1.00,
        #   so the field cannot express it. The ramp lives where the real driver's does -- webots-bridge
        #   apply_pending_speed_command(), fed from SVD48VBase's own config (SVD48V.py:129-130 is the
        #   original). Adding it here would COMPOSE with that ramp: the sim would then accelerate more
        #   slowly than either the hardware or the number written here.
        # !! DO NOT lower `maxVelocity` to maxLinSpeed/wheelRadius. It is a PER-WHEEL bound while the
        #   real limits are per-AXIS of the twist, and a LEGAL twist can demand more wheel speed than
        #   v_max/r: worst legal case is 21.95 rad/s (P3Bot, at advz 0.7 + advx 0.7 + rot 1.5) and
        #   14.18 (Shadow). Both are under 30, so once the bridge clips the twist this never binds.
        #   Capping it at 8.75 would silently distort every combined motion -- a NEW sim2real error
        #   introduced while closing one.
        # The twist clamp itself mirrors SVD48VBase/src/specificworker.py:161-173.
        RotationalMotor {
          name "wheel1"
          maxVelocity 30
        }
        PositionSensor {
          name "wheel1sensor"
        }
      ]
      endPoint Solid {
        translation 0.125 -0.24 0.08
        rotation 0 -0.9999999999999999 0 2.1896752360602516
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.75 0.75 0.75
              roughness 0.3
            }
            geometry Mesh {
              url [
                "../protos/p3bot_meshes/omnidirectional_wheel.stl"
              ]
            }
          }
        ]
        name "wheel1"
        contactMaterial "InteriorWheelMat"
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.04
              radius 0.08
              subdivision 24
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.4
        }
      }
    }
    DEF WHEEL2 HingeJoint {
      jointParameters HingeJointParameters {
        position -15.7760241754398
        axis 0 -1 0
        anchor 0.125 0.24 0.08
      }
      device [
        RotationalMotor {
          name "wheel2"
          maxVelocity 30
        }
        PositionSensor {
          name "wheel2sensor"
        }
      ]
      endPoint Solid {
        translation 0.125 0.24 0.08
        rotation 0.9994187048598588 -0.00215242461320652 -0.034023807025769855 3.1414461010404153
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.75 0.75 0.75
              roughness 0.3
            }
            geometry Mesh {
              url [
                "../protos/p3bot_meshes/omnidirectional_wheel.stl"
              ]
            }
          }
        ]
        name "wheel2"
        contactMaterial "ExteriorWheelMat"
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.04
              radius 0.08
              subdivision 24
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.4
        }
      }
    }
    DEF WHEEL3 HingeJoint {
      jointParameters HingeJointParameters {
        position -0.6414360882822983
        axis 0 1 0
        anchor -0.125 -0.24 0.08
      }
      device [
